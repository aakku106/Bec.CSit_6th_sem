@{
    ViewData["Title"] = "Cat Page";
    var name = "OrangeKat";
    var age = 6;
    var cats = new List<string> { "orange", "black", "white", "brown", "jangali" };
}

<div class="text-center">
    <h1 class="display-4">Welcome Cat</h1>
    catName: @name
    age: @age
    @if (age < 18)
    {
        <h1> @name Can't vote</h1>
    }
    <ul>

        @foreach (var cat in cats)
        {
            <li>@cat</li>
        }
    </ul>
</div>
